# Flask
FLASK_DEBUG=True
FLASK_SECRET_KEY=change-me

# Game
GAME_ROOM_ID=room_default

# Database
# Use sqlite for a simple local setup, or mysql for a shared database.
DB_ENGINE=sqlite
DB_FILE=spassmonopoly.db

# MySQL settings, only needed with DB_ENGINE=mysql.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=spassmonopoly
